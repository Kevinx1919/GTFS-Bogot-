// Catálogo del snapshot. Mantiene identidad por versión y hash; ubicación se aplica virtualmente al puente.
Red · Ubicaciones =
VAR ScopePairs=SUMMARIZE(dim_gtfs_snapshot,dim_gtfs_snapshot[source_feed_version],dim_gtfs_snapshot[source_sha256])
VAR StopFilter=VALUES(silver_gtfs_stops[stop_key])
VAR BC=CALCULATETABLE(gold_gtfs_route_stop,REMOVEFILTERS(gold_gtfs_route_stop[report_stop_label]))
VAR B=CALCULATETABLE(gold_gtfs_route_stop,TREATAS(StopFilter,gold_gtfs_route_stop[stop_key]))
VAR K=SUMMARIZE(B,gold_gtfs_route_stop[stop_key])
VAR AllB=CALCULATETABLE(gold_gtfs_route_stop,REMOVEFILTERS(gold_gtfs_route_stop),TREATAS(ScopePairs,gold_gtfs_route_stop[source_feed_version],gold_gtfs_route_stop[source_sha256]))
VAR Degrees=GROUPBY(AllB,gold_gtfs_route_stop[stop_key],"_degree",COUNTX(CURRENTGROUP(),1))
VAR D=FILTER(Degrees,gold_gtfs_route_stop[stop_key] IN K)
VAR StopsAll=CALCULATETABLE(silver_gtfs_stops,REMOVEFILTERS(silver_gtfs_stops),TREATAS(ScopePairs,silver_gtfs_stops[source_feed_version],silver_gtfs_stops[source_sha256]))
VAR SelectedStops=FILTER(StopsAll,silver_gtfs_stops[stop_key] IN K)
RETURN IF([Red · Fuente disponible],COALESCE(COUNTROWS(K),0))

// Catálogo del snapshot. Mantiene identidad por versión y hash; ubicación se aplica virtualmente al puente.
Red · Compartidas =
VAR ScopePairs=SUMMARIZE(dim_gtfs_snapshot,dim_gtfs_snapshot[source_feed_version],dim_gtfs_snapshot[source_sha256])
VAR StopFilter=VALUES(silver_gtfs_stops[stop_key])
VAR BC=CALCULATETABLE(gold_gtfs_route_stop,REMOVEFILTERS(gold_gtfs_route_stop[report_stop_label]))
VAR B=CALCULATETABLE(gold_gtfs_route_stop,TREATAS(StopFilter,gold_gtfs_route_stop[stop_key]))
VAR K=SUMMARIZE(B,gold_gtfs_route_stop[stop_key])
VAR AllB=CALCULATETABLE(gold_gtfs_route_stop,REMOVEFILTERS(gold_gtfs_route_stop),TREATAS(ScopePairs,gold_gtfs_route_stop[source_feed_version],gold_gtfs_route_stop[source_sha256]))
VAR Degrees=GROUPBY(AllB,gold_gtfs_route_stop[stop_key],"_degree",COUNTX(CURRENTGROUP(),1))
VAR D=FILTER(Degrees,gold_gtfs_route_stop[stop_key] IN K)
VAR StopsAll=CALCULATETABLE(silver_gtfs_stops,REMOVEFILTERS(silver_gtfs_stops),TREATAS(ScopePairs,silver_gtfs_stops[source_feed_version],silver_gtfs_stops[source_sha256]))
VAR SelectedStops=FILTER(StopsAll,silver_gtfs_stops[stop_key] IN K)
RETURN IF([Red · Fuente disponible],COALESCE(COUNTROWS(FILTER(D,[_degree]>=2)),0))

// Catálogo del snapshot. Mantiene identidad por versión y hash; ubicación se aplica virtualmente al puente.
Red · Rutas =
VAR ScopePairs=SUMMARIZE(dim_gtfs_snapshot,dim_gtfs_snapshot[source_feed_version],dim_gtfs_snapshot[source_sha256])
VAR StopFilter=VALUES(silver_gtfs_stops[stop_key])
VAR BC=CALCULATETABLE(gold_gtfs_route_stop,REMOVEFILTERS(gold_gtfs_route_stop[report_stop_label]))
VAR B=CALCULATETABLE(gold_gtfs_route_stop,TREATAS(StopFilter,gold_gtfs_route_stop[stop_key]))
VAR K=SUMMARIZE(B,gold_gtfs_route_stop[stop_key])
VAR AllB=CALCULATETABLE(gold_gtfs_route_stop,REMOVEFILTERS(gold_gtfs_route_stop),TREATAS(ScopePairs,gold_gtfs_route_stop[source_feed_version],gold_gtfs_route_stop[source_sha256]))
VAR Degrees=GROUPBY(AllB,gold_gtfs_route_stop[stop_key],"_degree",COUNTX(CURRENTGROUP(),1))
VAR D=FILTER(Degrees,gold_gtfs_route_stop[stop_key] IN K)
VAR StopsAll=CALCULATETABLE(silver_gtfs_stops,REMOVEFILTERS(silver_gtfs_stops),TREATAS(ScopePairs,silver_gtfs_stops[source_feed_version],silver_gtfs_stops[source_sha256]))
VAR SelectedStops=FILTER(StopsAll,silver_gtfs_stops[stop_key] IN K)
RETURN IF([Red · Fuente disponible],COALESCE(COUNTROWS(SUMMARIZE(B,gold_gtfs_route_stop[route_key])),0))

