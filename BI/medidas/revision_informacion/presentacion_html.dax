// Catálogo 2026 del contexto de componente y ruta. Las fechas no convierten casos en viajes diarios.
Revisión · Encabezado HTML =
VAR C=SELECTEDVALUE(silver_gtfs_agency[report_component],"Todo el sistema") VAR R=IF(HASONEVALUE(silver_gtfs_routes[route_key])," · " & SELECTEDVALUE(silver_gtfs_routes[report_route_label]),"") RETURN "<header class='page-heading'><div><p class='section-label'>Movilidad Bogotá / Del motivo al viaje que conviene revisar</p><h1>Revisión de información</h1></div><div class='scope'><strong>" & C & R & "</strong><span>Catálogo 2026 · No representa fallos operativos</span></div></header>"

// Catálogo 2026 del contexto de componente y ruta. Las fechas no convierten casos en viajes diarios.
Revisión · Indicadores HTML =
VAR N=[Revisión · Evaluados] RETURN IF([Revisión · Fuente disponible],"<section class='review-kpis'><article><span>Viajes evaluados</span><strong>" & FORMAT(N,"#,0","es-CO") & "</strong><small>Catálogo del componente y ruta</small></article><article><span>Sin visitas publicadas</span><strong>" & FORMAT([Revisión · Sin visitas],"#,0","es-CO") & "</strong><small>" & IF(N=0,"Sin denominador",FORMAT(DIVIDE([Revisión · Sin visitas],N),"0.00%","es-CO") & " de los evaluados") & "</small></article><article><span>Con una sola visita</span><strong>" & FORMAT([Revisión · Una visita],"#,0","es-CO") & "</strong><small>No describe un recorrido completo</small></article><article><span>Fuera del perfil horario</span><strong>" & FORMAT([Revisión · Excluidos],"#,0","es-CO") & "</strong><small>Incluye plantillas; no implica error</small></article></section>","<section class='review-kpis'><p class='review-empty'>Falta evaluación Gold para esta identidad. La ausencia no equivale a cero casos.</p></section>")

// Catálogo 2026 del contexto de componente y ruta. Las fechas no convierten casos en viajes diarios.
Revisión · Motivos HTML =
VAR Base=CALCULATETABLE(gold_gtfs_trip_timing,REMOVEFILTERS(gold_gtfs_trip_timing[report_review_reason],gold_gtfs_trip_timing[timing_status],gold_gtfs_trip_timing[trip_id],gold_gtfs_trip_timing[trip_key],gold_gtfs_trip_timing[report_route_label]))
VAR Motivos=CALCULATETABLE(VALUES(gold_gtfs_trip_timing[timing_status]),REMOVEFILTERS(gold_gtfs_trip_timing[trip_id],gold_gtfs_trip_timing[trip_key],gold_gtfs_trip_timing[report_route_label]))
VAR Casos=FILTER(Base,gold_gtfs_trip_timing[timing_status]<>"eligible" && gold_gtfs_trip_timing[timing_status] IN Motivos)
VAR Total=COUNTROWS(Base) VAR Excl=[Revisión · Excluidos] VAR Elig=[Revisión · Elegibles]
VAR Defs={ ("no_visits","Sin visitas",1),("one_visit","Una visita",2),("frequency_template","Plantillas de frecuencia",3),("missing_endpoints","Sin extremos horarios",4),("reversed_endpoints","Extremos invertidos",5) }
VAR Filas=CONCATENATEX(Defs,VAR Code=[Value1] VAR N=COALESCE(COUNTROWS(FILTER(Base,gold_gtfs_trip_timing[timing_status]=Code)),0) VAR W=DIVIDE(N,MAX(1,Excl))*100 RETURN "<div class='reason-row'><span>" & [Value2] & "</span><span class='reason-track'><i style='width:" & FORMAT(W,"0.0","en-US") & "%;background:" & IF(Code="frequency_template","#FFC928",IF(Code="one_visit","#E98C94","#DD212C")) & "'></i></span><strong>" & FORMAT(N,"#,0","es-CO") & "</strong></div>","",[Value3],ASC)
RETURN IF([Revisión · Fuente disponible],"<section class='review-reasons'><p class='insight-kicker'>Contexto completo · Antes del motivo</p><div class='reason-total'><h2>" & FORMAT(Excl,"#,0","es-CO") & "</h2><span>fuera del perfil horario<br><strong>" & IF(Total=0,"—",FORMAT(DIVIDE(Excl,Total),"0.00%","es-CO")) & " de " & FORMAT(Total,"#,0","es-CO") & " evaluados</strong></span></div><div class='eligible-line'><span>Elegibles para extremos publicados</span><strong>" & FORMAT(Elig,"#,0","es-CO") & "</strong></div>" & Filas & "<p class='review-caution'>Los motivos no se superponen. Una plantilla usa ventanas de frecuencia; no constituye por sí misma un dato inválido.</p></section>","<section class='review-reasons'><p class='review-empty'>Falta evaluación Gold. No convierto esa ausencia en cero casos.</p></section>")

// Catálogo 2026 del contexto de componente y ruta. Las fechas no convierten casos en viajes diarios.
Revisión · Rutas HTML =
VAR Base=CALCULATETABLE(gold_gtfs_trip_timing,REMOVEFILTERS(gold_gtfs_trip_timing[report_review_reason],gold_gtfs_trip_timing[timing_status],gold_gtfs_trip_timing[trip_id],gold_gtfs_trip_timing[trip_key],gold_gtfs_trip_timing[report_route_label]))
VAR Motivos=CALCULATETABLE(VALUES(gold_gtfs_trip_timing[timing_status]),REMOVEFILTERS(gold_gtfs_trip_timing[trip_id],gold_gtfs_trip_timing[trip_key],gold_gtfs_trip_timing[report_route_label]))
VAR Casos=FILTER(Base,gold_gtfs_trip_timing[timing_status]<>"eligible" && gold_gtfs_trip_timing[timing_status] IN Motivos)
VAR Counts=GROUPBY(Casos,gold_gtfs_trip_timing[route_id],gold_gtfs_trip_timing[report_route_label],"_n",COUNTX(CURRENTGROUP(),1)) VAR TopR=TOPN(5,Counts,[_n],DESC,gold_gtfs_trip_timing[route_id],ASC) VAR Maximo=MAX(1,MAXX(TopR,[_n])) VAR Motivo=SELECTEDVALUE(gold_gtfs_trip_timing[report_review_reason],"Todos los motivos")
VAR Filas=CONCATENATEX(TopR,VAR IdRuta=gold_gtfs_trip_timing[route_id] VAR NTotal=COUNTROWS(FILTER(Base,gold_gtfs_trip_timing[route_id]=IdRuta)) RETURN "<div class='review-route'><div class='route-label'><strong>" & SUBSTITUTE(SUBSTITUTE(gold_gtfs_trip_timing[report_route_label],"&","&amp;"),"<","&lt;") & "</strong><span>" & FORMAT([_n],"#,0","es-CO") & " de " & FORMAT(NTotal,"#,0","es-CO") & " · " & FORMAT(DIVIDE([_n],NTotal),"0.0%","es-CO") & "</span></div><div class='review-route-track'><i style='width:" & FORMAT(DIVIDE([_n],Maximo)*100,"0.0","en-US") & "%'></i></div></div>","",[_n],DESC)
RETURN IF([Revisión · Fuente disponible],"<section class='review-routes'><div class='panel-head'><h2>¿En qué rutas concentro la revisión?</h2><span>Casos: " & FORMAT(COALESCE(COUNTROWS(Casos),0),"#,0","es-CO") & " · Rutas: " & FORMAT(COALESCE(COUNTROWS(Counts),0),"0") & "</span></div><p class='subtitle'>" & Motivo & " · Hasta cinco rutas por cantidad de casos</p>" & IF(COUNTROWS(Casos)=0,"<div class='review-clear'><strong>Sin casos para ese motivo.</strong><p>La selección no tiene viajes excluidos por estas reglas. No demuestra calidad completa ni operación observada.</p></div>",Filas) & "<p class='review-note'>Longitud relativa al máximo. Cada porcentaje usa todos los viajes de su propia ruta.</p></section>","<section class='review-routes'><p class='review-empty'>Selecciona una identidad con ambas fuentes Gold disponibles.</p></section>")

// Catálogo 2026 del contexto de componente y ruta. Las fechas no convierten casos en viajes diarios.
Revisión · Acción HTML =
VAR Uno=HASONEVALUE(gold_gtfs_trip_timing[trip_key]) VAR Code=SELECTEDVALUE(gold_gtfs_trip_timing[timing_status]) VAR TripCode=SELECTEDVALUE(gold_gtfs_trip_timing[trip_id]) VAR Label=SELECTEDVALUE(gold_gtfs_trip_timing[report_route_label])
VAR SinCasos=[Revisión · Casos del motivo]=0 VAR Titulo=IF(SinCasos&&ISBLANK(Code),"Sin casos para esos filtros.",SWITCH(Code,"no_visits","Revisa la lista de visitas.","one_visit","Una visita no describe el recorrido.","frequency_template","Lee sus ventanas de frecuencia.","missing_endpoints","Consulta los extremos publicados.","reversed_endpoints","Revisa el orden de los extremos.","eligible","Este grupo entra al perfil horario.","Elige un motivo y consulta un viaje."))
VAR Mensaje=IF(SinCasos&&ISBLANK(Code),"No encuentro viajes excluidos en esta selección. Revisa otros motivos; este resultado no certifica operación ni calidad completa.",SWITCH(Code,"no_visits","El viaje está declarado, pero no relaciona visitas Silver. Revisa el archivo fuente antes de completar información.","one_visit","Conservo la visita disponible. No deduzco un recorrido entre dos ubicaciones ni reconstruyo otras visitas.","frequency_template","La plantilla necesita sus ventanas. No la convierto en una sola salida ni en un error del servicio.","missing_endpoints","Falta una hora extrema. Conservo la ausencia y no tomo otra hora intermedia como sustituto.","reversed_endpoints","La llegada final precede a la salida inicial. Conservo el diagnóstico y reviso la secuencia original.","eligible","Los extremos cumplen las reglas del perfil. Esa elegibilidad no certifica puntualidad ni un recorrido completo.","Selecciona una fila de la tabla para consultar su ID y motivo. Investiga la publicación antes de inferir fallos operativos."))
RETURN IF([Revisión · Fuente disponible],"<section class='review-action'><p class='section-label'>Siguiente revisión</p><h2>" & Titulo & "</h2>" & IF(Uno,"<p class='trip-reference'><strong>" & SUBSTITUTE(SUBSTITUTE(TripCode,"&","&amp;"),"<","&lt;") & "</strong><span>" & Label & " · Visitas: " & FORMAT(SELECTEDVALUE(gold_gtfs_trip_timing[visit_count]),"0") & " · Ventanas: " & FORMAT(SELECTEDVALUE(gold_gtfs_trip_timing[frequency_window_count]),"0") & "</span></p>","") & "<p class='action-text'>" & Mensaje & "</p><small>Fuente publicada ≠ operación observada.</small></section>","<section class='review-action'><p class='review-empty'>No hay evaluación disponible para consultar casos.</p></section>")

// Catálogo 2026 del contexto de componente y ruta. Las fechas no convierten casos en viajes diarios.
Revisión · Tabla marco HTML =
"<section class='review-table-frame'><h2>Viajes para revisar</h2><p>El motivo filtra la lista. Una fila actualiza solo la ficha «Siguiente revisión».</p></section>"

// Catálogo 2026 del contexto de componente y ruta. Las fechas no convierten casos en viajes diarios.
Revisión · Tabla previa HTML =
VAR Base=CALCULATETABLE(gold_gtfs_trip_timing,REMOVEFILTERS(gold_gtfs_trip_timing[report_review_reason],gold_gtfs_trip_timing[timing_status],gold_gtfs_trip_timing[trip_id],gold_gtfs_trip_timing[trip_key],gold_gtfs_trip_timing[report_route_label]))
VAR Motivos=CALCULATETABLE(VALUES(gold_gtfs_trip_timing[timing_status]),REMOVEFILTERS(gold_gtfs_trip_timing[trip_id],gold_gtfs_trip_timing[trip_key],gold_gtfs_trip_timing[report_route_label]))
VAR Casos=FILTER(Base,gold_gtfs_trip_timing[timing_status]<>"eligible" && gold_gtfs_trip_timing[timing_status] IN Motivos)
VAR TopC=TOPN(8,Casos,gold_gtfs_trip_timing[trip_id],ASC)
VAR Filas=CONCATENATEX(TopC,"<tr><td>" & gold_gtfs_trip_timing[report_route_label] & "</td><td>" & SUBSTITUTE(SUBSTITUTE(gold_gtfs_trip_timing[trip_id],"&","&amp;"),"<","&lt;") & "</td><td>" & gold_gtfs_trip_timing[report_review_reason] & "</td><td>" & FORMAT(gold_gtfs_trip_timing[visit_count],"0") & "</td></tr>","",gold_gtfs_trip_timing[trip_id],ASC)
RETURN IF([Revisión · Fuente disponible],"<div class='review-preview-table'><table><thead><tr><th>Ruta · ID</th><th>Viaje declarado</th><th>Motivo</th><th>Visitas</th></tr></thead><tbody>" & Filas & "</tbody></table>" & IF(COUNTROWS(Casos)=0,"<p class='review-empty'>Sin viajes para revisar con ese motivo.</p>","") & "</div>","<p class='review-empty'>Falta evaluación Gold.</p>")

