VAR Casos=FILTER(Base,gold_gtfs_trip_timing[timing_status]<>"eligible" && gold_gtfs_trip_timing[timing_status] IN Motivos)
RETURN IF([Revisión · Fuente disponible],COALESCE(COUNTROWS(FILTER(Base,gold_gtfs_trip_timing[timing_status]="no_visits")),0))

