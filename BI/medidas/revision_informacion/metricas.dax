// Catálogo 2026 del contexto de componente y ruta. Las fechas no convierten casos en viajes diarios.
Revisión · Porcentaje excluido =
DIVIDE([Revisión · Excluidos],[Revisión · Evaluados])

// Filtro de la tabla nativa: muestra solamente viajes excluidos del perfil horario. La selección del motivo se conserva.
Revisión · Mostrar caso =
IF(HASONEVALUE(gold_gtfs_trip_timing[trip_key])&&SELECTEDVALUE(gold_gtfs_trip_timing[timing_status])<>"eligible",1)

// Catálogo 2026 del contexto de componente y ruta. Las fechas no convierten casos en viajes diarios.
Revisión · Visitas del caso =
IF(HASONEVALUE(gold_gtfs_trip_timing[trip_key]),SUM(gold_gtfs_trip_timing[visit_count]))
