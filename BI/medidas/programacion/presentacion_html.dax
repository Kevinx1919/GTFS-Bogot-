// Selección explícita de servicios activos; conserva identidad de snapshot, ruta y componente.
Programación · Encabezado HTML =
VAR C=SELECTEDVALUE(silver_gtfs_agency[report_component],"Todo el sistema") VAR R=IF(HASONEVALUE(silver_gtfs_routes[route_key])," · Ruta " & SELECTEDVALUE(silver_gtfs_routes[route_short_name]),"") RETURN "<header class='page-heading'><div><p class='section-label'>Movilidad Bogotá / Calendario y horas publicadas</p><h1>Programación</h1></div><div class='scope'><strong>" & C & R & "</strong><span>Del patrón diario al detalle de los viajes.</span></div></header>"

// Cantidades y extremos de viajes elegibles. Horas GTFS sin módulo 24, A/B separados de plantillas.
Programación · Indicadores HTML =
VAR Datos={1,2,3,4}
VAR Tarjetas=CONCATENATEX(Datos,VAR I=[Value] VAR A=SWITCH(I,1,[Programación · Elegibles],2,[Programación · Primera salida segundos],3,[Programación · Última llegada segundos],[Panorama · Plantillas]) VAR B=SWITCH(I,1,[Programación · Elegibles B],2,[Programación · Primera salida B segundos],3,[Programación · Última llegada B segundos],[Panorama · Plantillas comparación]) VAR VA=IF(I IN {2,3},IF(ISBLANK(A),"—",FORMAT(INT(A/3600),"00") & ":" & FORMAT(INT(MOD(A,3600)/60),"00") & ":" & FORMAT(MOD(A,60),"00")),IF(ISBLANK(A),"—",FORMAT(A,"#,0","es-CO"))) VAR VB=IF(I IN {2,3},IF(ISBLANK(B),"—",FORMAT(INT(B/3600),"00") & ":" & FORMAT(INT(MOD(B,3600)/60),"00") & ":" & FORMAT(MOD(B,60),"00")),IF(ISBLANK(B),"—",FORMAT(B,"#,0","es-CO"))) RETURN "<article><span>" & SWITCH(I,1,"Viajes con extremos elegibles",2,"Primera salida publicada",3,"Última llegada publicada","Plantillas activas") & "</span><strong>" & VA & "</strong><small>" & IF(I=1,"De " & IF(ISBLANK([Programación · Viajes activos]),"—",FORMAT([Programación · Viajes activos],"#,0","es-CO")) & " viajes activos · B: " & VB,IF(I IN {2,3},"Hora de servicio · B: " & VB,"Ventanas A: " & IF(ISBLANK([Programación · Ventanas activas]),"—",FORMAT([Programación · Ventanas activas],"0")) & " · B: " & VB & " plantillas")) & "</small></article>","",[Value],ASC) RETURN "<section class='program-kpis'>" & Tarjetas & "</section>"

// Muestra limitada a seis primeros viajes elegibles de A. Tooltip conserva ID y precisión; no es una lista completa.
Programación · Muestra HTML =
VAR Servicios=VALUES(silver_gtfs_service_dates[service_key])
VAR K=CALCULATETABLE(VALUES(silver_gtfs_trips[trip_key]),TREATAS(Servicios,silver_gtfs_trips[service_key]))
VAR T=CALCULATETABLE(gold_gtfs_trip_timing,TREATAS(K,gold_gtfs_trip_timing[trip_key]))
VAR E=FILTER(T,gold_gtfs_trip_timing[timing_status]="eligible")
VAR Primeros=TOPN(6,E,gold_gtfs_trip_timing[first_departure_time_seconds],ASC,gold_gtfs_trip_timing[trip_key],ASC)
VAR Filas=CONCATENATEX(Primeros,VAR S=gold_gtfs_trip_timing[first_departure_time_seconds] VAR L=gold_gtfs_trip_timing[last_arrival_time_seconds] VAR Ruta=LOOKUPVALUE(silver_gtfs_routes[route_short_name],silver_gtfs_routes[route_id],gold_gtfs_trip_timing[route_id],silver_gtfs_routes[source_sha256],gold_gtfs_trip_timing[source_sha256],silver_gtfs_routes[source_feed_version],gold_gtfs_trip_timing[source_feed_version]) VAR ViajeTexto=SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(gold_gtfs_trip_timing[trip_id],"&","&amp;"),"<","&lt;"),"'","&#39;") RETURN "<tr title='Viaje " & ViajeTexto & " · " & gold_gtfs_trip_timing[endpoint_time_precision] & "'><td>" & COALESCE(Ruta,"Sin nombre") & "</td><td>" & IF(ISBLANK(S),"—",FORMAT(INT(S/3600),"00") & ":" & FORMAT(INT(MOD(S,3600)/60),"00") & ":" & FORMAT(MOD(S,60),"00")) & "</td><td>" & IF(ISBLANK(L),"—",FORMAT(INT(L/3600),"00") & ":" & FORMAT(INT(MOD(L,3600)/60),"00") & ":" & FORMAT(MOD(L,60),"00")) & "</td></tr>","",gold_gtfs_trip_timing[first_departure_time_seconds],ASC)
RETURN "<div class='trip-sample'><div class='sample-heading'><h3>Primeros viajes elegibles de A</h3><span>" & FORMAT(COALESCE(COUNTROWS(Primeros),0),"0") & " de " & FORMAT(COALESCE(COUNTROWS(E),0),"#,0","es-CO") & "</span></div>" & IF(COUNTROWS(E)=0,"<p class='program-empty'>Sin ejemplos elegibles. Revisa las ventanas y las exclusiones.</p>","<table><thead><tr><th>Ruta</th><th>Salida</th><th>Llegada final</th></tr></thead><tbody>" & Filas & "</tbody></table>") & "</div>"

// Calendario mensual de cantidades diarias. Cero, fecha externa y ausencia se distinguen; no etiqueta festivos.
Programación · Calendario HTML =
VAR F=SELECTEDVALUE(dim_gtfs_fecha[fecha]) VAR B=SELECTEDVALUE(dim_gtfs_fecha_comparacion[fecha]) VAR Mes=DATE(YEAR(F),MONTH(F),1) VAR Ultimo=EOMONTH(F,0) VAR Inicio=Mes-WEEKDAY(Mes,2)+1 VAR Freq=[Panorama · Usa plantillas]
VAR Dias=ADDCOLUMNS(CALENDAR(Inicio,Inicio+41),"_v",VAR D=[Date] RETURN IF(MONTH(D)=MONTH(F),CALCULATE(IF(Freq,[Panorama · Plantillas],[Panorama · Viajes sin frecuencia]),REMOVEFILTERS(dim_gtfs_fecha),TREATAS({D},dim_gtfs_fecha[fecha]))))
VAR Maximo=MAX(1,MAXX(Dias,[_v]))
VAR Celdas=CONCATENATEX(Dias,VAR D=[Date] VAR V=[_v] VAR Fuera=MONTH(D)<>MONTH(F) VAR Capa=IF(ISBLANK(V)||V=0,0,1+INT(DIVIDE(V,Maximo)*3)) RETURN "<div class='calendar-day level-" & FORMAT(Capa,"0") & IF(Fuera," outside","") & IF(D=F," selected-a",IF(D=B && NOT(Fuera)," selected-b","")) & "' title='" & FORMAT(D,"dddd d mmm","es-CO") & IF(Fuera,"",": " & IF(ISBLANK(V),"Fuera del horizonte",FORMAT(V,"#,0","es-CO"))) & "'><span>" & IF(Fuera,"",FORMAT(D,"d")) & "</span><strong>" & IF(Fuera,"",IF(ISBLANK(V),"—",IF(V>=1000,FORMAT(V/1000,"0.0","es-CO") & "k",FORMAT(V,"0")))) & "</strong></div>","",[Date],ASC)
RETURN IF(ISBLANK(F),"<section class='panel calendar-panel'><h2>Selecciona una fecha analizada.</h2></section>","<section class='panel calendar-panel'><div class='panel-head'><h2>" & FORMAT(F,"mmmm yyyy","es-CO") & "</h2><span>Calendario de A</span></div><p class='subtitle'>" & IF(Freq,"Plantillas por frecuencia","Viajes sin frecuencias") & " por día · k = miles</p><div class='calendar-weekdays'><span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span></div><div class='calendar-grid'>" & Celdas & "</div><div class='calendar-legend'><span><i class='outline-a'></i>A analizada</span><span><i class='outline-b'></i>B comparada, si está en el mes</span></div>" & [Programación · Muestra HTML] & "</section>")

// Distribución de primeras salidas, una por viaje elegible y fecha; conciliable con elegibles, sin expandir plantillas.
Programación · Horas HTML =
VAR Servicios=VALUES(silver_gtfs_service_dates[service_key])
VAR K=CALCULATETABLE(VALUES(silver_gtfs_trips[trip_key]),TREATAS(Servicios,silver_gtfs_trips[service_key]))
VAR T=CALCULATETABLE(gold_gtfs_trip_timing,TREATAS(K,gold_gtfs_trip_timing[trip_key]))
VAR E=FILTER(T,gold_gtfs_trip_timing[timing_status]="eligible")
VAR FechaB=SELECTEDVALUE(dim_gtfs_fecha_comparacion[fecha])
VAR ServiciosB=CALCULATETABLE(VALUES(silver_gtfs_service_dates[service_key]),REMOVEFILTERS(dim_gtfs_fecha),TREATAS({FechaB},dim_gtfs_fecha[fecha]))
VAR KB=CALCULATETABLE(VALUES(silver_gtfs_trips[trip_key]),TREATAS(ServiciosB,silver_gtfs_trips[service_key]))
VAR TB=CALCULATETABLE(gold_gtfs_trip_timing,TREATAS(KB,gold_gtfs_trip_timing[trip_key]))
VAR EB=FILTER(TB,gold_gtfs_trip_timing[timing_status]="eligible")
VAR F=SELECTEDVALUE(dim_gtfs_fecha[fecha])
VAR HA=MAXX(E,INT(gold_gtfs_trip_timing[first_departure_time_seconds]/3600)) VAR HB=MAXX(EB,INT(gold_gtfs_trip_timing[first_departure_time_seconds]/3600)) VAR Limite=MAX(24,MAX(HA,HB))
VAR Horas=ADDCOLUMNS(GENERATESERIES(0,Limite),"_a",VAR H=[Value] RETURN COALESCE(COUNTROWS(FILTER(E,INT(gold_gtfs_trip_timing[first_departure_time_seconds]/3600)=H)),0),"_b",VAR H=[Value] RETURN COALESCE(COUNTROWS(FILTER(EB,INT(gold_gtfs_trip_timing[first_departure_time_seconds]/3600)=H)),0))
VAR Maximo=MAX(1,MAXX(Horas,MAX([_a],[_b]))) VAR Ancho=740/(Limite+1)
VAR Pico=TOPN(1,Horas,[_a],DESC,[Value],ASC) VAR PicoH=MAXX(Pico,[Value])
VAR Barras=CONCATENATEX(Horas,VAR H=[Value] VAR X=40+H*Ancho VAR AA=DIVIDE([_a],Maximo)*104 VAR BB=DIVIDE([_b],Maximo)*104 RETURN "<g><title>" & FORMAT(H,"00") & ":00 · A " & FORMAT([_a],"#,0","es-CO") & " · B " & FORMAT([_b],"#,0","es-CO") & "</title><rect x='" & FORMAT(X,"0.0","en-US") & "' y='" & FORMAT(124-AA,"0.0","en-US") & "' width='" & FORMAT(Ancho*.32,"0.0","en-US") & "' height='" & FORMAT(AA,"0.0","en-US") & "' rx='1' fill='#DD212C'/><rect x='" & FORMAT(X+Ancho*.38,"0.0","en-US") & "' y='" & FORMAT(124-BB,"0.0","en-US") & "' width='" & FORMAT(Ancho*.32,"0.0","en-US") & "' height='" & FORMAT(BB,"0.0","en-US") & "' rx='1' fill='#FFC928'/>" & IF(MOD(H,4)=0,"<text x='" & FORMAT(X,"0.0","en-US") & "' y='146' class='axis'>" & FORMAT(H,"00") & "h</text>","") & "</g>","",[Value],ASC)
VAR SinElegibles=COALESCE(COUNTROWS(E),0)+COALESCE(COUNTROWS(EB),0)=0
RETURN IF(ISBLANK([Panorama · Rutas])||ISBLANK(FechaB),"<section class='panel hourly-panel'><h2>Selecciona dos fechas.</h2><p class='program-empty'>El cálculo necesita una fecha válida dentro del horizonte publicado.</p></section>","<section class='panel hourly-panel'><div class='panel-head'><h2>Primeras salidas declaradas por hora</h2><span>" & IF(COUNTROWS(E)>0,"Mayor concentración A: " & FORMAT(PicoH,"00") & "h","") & "</span></div><p class='subtitle'>Un conteo por viaje elegible · Hora de servicio</p>" & IF(ISBLANK(F),"<p class='program-empty'>Selecciona una fecha analizada.</p>",IF(SinElegibles,"<p class='program-empty'>Sin salidas individuales elegibles. Revisa las ventanas de frecuencia y los motivos de exclusión.</p>","<svg viewBox='0 0 810 154' role='img' aria-label='Primeras salidas de viajes elegibles por hora para A y B'><path d='M36 20H790M36 72H790M36 124H790' stroke='#E1E6D9'/><text x='31' y='24' text-anchor='end' class='axis'>" & IF(Maximo>=1000,FORMAT(Maximo/1000,"0.0","es-CO") & "k",FORMAT(Maximo,"0")) & "</text><text x='31' y='128' text-anchor='end' class='axis'>0</text>" & Barras & "</svg>")) & "<div class='legend'><span><i class='a'></i>A analizada</span><span><i class='b'></i>B comparada</span><span>24h o más continúa al día siguiente.</span></div></section>")

// Hasta ocho ventanas activas de A. Mantiene segundos y exact_times; no convierte headway en espera.
Programación · Frecuencias HTML =
VAR Servicios=VALUES(silver_gtfs_service_dates[service_key])
VAR K=CALCULATETABLE(VALUES(silver_gtfs_trips[trip_key]),TREATAS(Servicios,silver_gtfs_trips[service_key]))
VAR T=CALCULATETABLE(gold_gtfs_trip_timing,TREATAS(K,gold_gtfs_trip_timing[trip_key]))
VAR E=FILTER(T,gold_gtfs_trip_timing[timing_status]="eligible")
VAR F=SELECTEDVALUE(dim_gtfs_fecha[fecha]) VAR W=CALCULATETABLE(silver_gtfs_frequencies,TREATAS(K,silver_gtfs_frequencies[trip_key])) VAR N=COALESCE(COUNTROWS(W),0) VAR Muestra=TOPN(8,W,silver_gtfs_frequencies[start_time_seconds],ASC,silver_gtfs_frequencies[trip_key],ASC) VAR Tope=MAX(86400,MAXX(W,silver_gtfs_frequencies[end_time_seconds]))
VAR Filas=CONCATENATEX(Muestra,VAR I=RANKX(Muestra,FORMAT(silver_gtfs_frequencies[start_time_seconds],"00000000") & silver_gtfs_frequencies[trip_key],,ASC,DENSE) VAR Y=I*25 VAR X=DIVIDE(silver_gtfs_frequencies[start_time_seconds],Tope)*190+110 VAR Ancho=DIVIDE(silver_gtfs_frequencies[end_time_seconds]-silver_gtfs_frequencies[start_time_seconds],Tope)*190 RETURN "<g><title>" & silver_gtfs_frequencies[trip_id] & " · exact_times=" & FORMAT(silver_gtfs_frequencies[exact_times_effective],"0") & "</title><text x='0' y='" & FORMAT(Y,"0") & "' class='axis'>" & LEFT(silver_gtfs_frequencies[start_time],5) & "–" & LEFT(silver_gtfs_frequencies[end_time],5) & "</text><rect x='110' y='" & FORMAT(Y-9,"0") & "' width='190' height='9' rx='3' fill='#E6EADB'/><rect x='" & FORMAT(X,"0.0","en-US") & "' y='" & FORMAT(Y-9,"0") & "' width='" & FORMAT(MAX(1,Ancho),"0.0","en-US") & "' height='9' rx='3' fill='#DD212C'/><text x='390' y='" & FORMAT(Y,"0") & "' text-anchor='end' class='frequency-gap'>" & FORMAT(silver_gtfs_frequencies[headway_secs],"0") & " s</text></g>","",silver_gtfs_frequencies[start_time_seconds],ASC)
RETURN IF(ISBLANK([Panorama · Rutas]),"<section class='panel frequency-panel'><h2>Selecciona una fecha analizada.</h2><p class='program-empty'>El cálculo necesita una fecha válida dentro del horizonte publicado.</p></section>","<section class='panel frequency-panel'><div class='panel-head'><h2>Ventanas de frecuencia en A</h2><span>" & FORMAT(MIN(8,N),"0") & " de " & FORMAT(N,"0") & "</span></div><p class='subtitle'>Intervalo publicado en segundos</p>" & IF(ISBLANK(F),"<p class='program-empty'>Selecciona una fecha analizada.</p>",IF(N=0,"<div class='no-frequency'><strong>Sin ventanas activas</strong><p>La selección se lee mediante sus viajes declarados, cuando tienen horarios elegibles.</p></div>","<svg viewBox='-2 0 400 " & FORMAT(MAX(70,MIN(8,N)*25+15),"0") & "' role='img' aria-label='Ventanas e intervalos de frecuencia publicados'>" & Filas & "</svg>")) & "<p class='program-note'>No convierto intervalos en espera ni genero salidas individuales. El código exact_times está en cada tooltip.</p></section>")

// Denominadores y precisión de extremos; motivos excluyentes y límites del cálculo.
Programación · Alcance HTML =
VAR Servicios=VALUES(silver_gtfs_service_dates[service_key])
VAR K=CALCULATETABLE(VALUES(silver_gtfs_trips[trip_key]),TREATAS(Servicios,silver_gtfs_trips[service_key]))
VAR T=CALCULATETABLE(gold_gtfs_trip_timing,TREATAS(K,gold_gtfs_trip_timing[trip_key]))
VAR E=FILTER(T,gold_gtfs_trip_timing[timing_status]="eligible")
VAR F=SELECTEDVALUE(dim_gtfs_fecha[fecha]) VAR Total=COALESCE(COUNTROWS(T),0) VAR NE=COALESCE(COUNTROWS(E),0) VAR Excl=Total-NE VAR Exact=COALESCE(COUNTROWS(FILTER(E,gold_gtfs_trip_timing[endpoint_time_precision]="exact_as_published")),0) VAR Aprox=COALESCE(COUNTROWS(FILTER(E,gold_gtfs_trip_timing[endpoint_time_precision]="approximate")),0) VAR Unknown=NE-Exact-Aprox
VAR Razones=CONCATENATEX(FILTER(ADDCOLUMNS({"no_visits","one_visit","frequency_template","missing_endpoints","reversed_endpoints"},"_n",VAR Codigo=[Value] RETURN COALESCE(COUNTROWS(FILTER(T,gold_gtfs_trip_timing[timing_status]=Codigo)),0)),[_n]>0),VAR Codigo=[Value] VAR N=[_n] RETURN IF(N>0,"<span>" & SWITCH(Codigo,"no_visits","Sin visitas","one_visit","Una visita","frequency_template","Plantillas","missing_endpoints","Extremos ausentes","Extremos invertidos") & ": <b>" & FORMAT(N,"#,0","es-CO") & "</b></span>","")," · ")
RETURN IF(ISBLANK([Panorama · Rutas]),"<section class='scope-panel'><h2>Selecciona una fecha analizada.</h2><p class='program-empty'>El cálculo necesita una fecha válida dentro del horizonte publicado.</p></section>","<section class='scope-panel'><p class='insight-kicker'>Cómo leer los horarios</p><h2>Los extremos necesitan contexto.</h2><div class='eligible-total'><strong>" & IF(ISBLANK(F),"—",FORMAT(NE,"#,0","es-CO")) & "</strong><span>de " & FORMAT(Total,"#,0","es-CO") & " viajes activos son elegibles en A.</span></div><dl><div><dt>Exactos según publicación</dt><dd>" & FORMAT(Exact,"#,0","es-CO") & "</dd></div><div><dt>Aproximados publicados</dt><dd>" & FORMAT(Aprox,"#,0","es-CO") & "</dd></div><div><dt>Precisión desconocida</dt><dd>" & FORMAT(Unknown,"#,0","es-CO") & "</dd></div></dl><div class='excluded'><strong>" & FORMAT(Excl,"#,0","es-CO") & " fuera del perfil horario</strong><p>" & IF(Excl=0,"Ningún viaje activo queda excluido por estas reglas.",Razones) & "</p></div><small>Los extremos no prueban continuidad, puntualidad ni duración observada. Exacto publicado no significa exactitud operacional.</small></section>")

// Navegación compartida con Panorama; acciones reales mediante botones nativos.
Programación · Navegación HTML =
"<aside class='sidebar-inner'><div class='brand'><svg viewBox='0 0 34 38' aria-hidden='true'><rect x='4' y='3' width='26' height='29' rx='6' fill='#DD212C'/><rect x='8' y='8' width='18' height='10' rx='2' fill='#FFF'/><path d='M9 23H25' stroke='#FFC928' stroke-width='3'/><circle cx='10' cy='29' r='2' fill='#FFF'/><circle cx='24' cy='29' r='2' fill='#FFF'/><path d='M8 33V36M26 33V36' stroke='#252A23' stroke-width='3'/></svg><strong>Movilidad<br>Bogotá</strong></div><div class='sidebar-note'><span class='brand-rule'></span><strong>Lee el servicio previsto.</strong><p>GTFS estático<br>Oferta planificada</p></div></aside>"

// Selección explícita de servicios activos; conserva identidad de snapshot, ruta y componente.
Programación · Fuente HTML =
"<footer class='source-strip'><strong>Fuente: GTFS de TransMilenio · 2026</strong><span>Calendario y horas publicadas. No son operación observada, espera ni flota.</span></footer>"
