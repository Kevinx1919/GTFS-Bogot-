-- Presentación HTML; las medidas numéricas conservan el cálculo.
Tarjeta agency HTML =
VAR Registros = COALESCE ( [Registros de agencia], 0 )
VAR Snapshots = COALESCE ( [Snapshots cargados], 0 )
VAR Versiones =
    SUMMARIZE (
        'silver_gtfs_agency',
        'silver_gtfs_agency'[source_feed_version],
        'silver_gtfs_agency'[source_sha256]
    )
VAR FilasVersion =
    CONCATENATEX (
        Versiones,
        VAR FeedVersionValue = 'silver_gtfs_agency'[source_feed_version]
        VAR SnapshotHashValue = 'silver_gtfs_agency'[source_sha256]
        VAR Cantidad = COALESCE ( CALCULATE ( [Registros de agencia] ), 0 )
        RETURN
            "<div style='display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #DADBD4'>"
            & "<div><strong>" & FeedVersionValue & "</strong><div style='font-size:11px;color:#535B57;margin-top:3px'>SHA-256 · "
            & LEFT ( SnapshotHashValue, 12 ) & "…</div></div><span style='font-size:22px;font-weight:700'>"
            & FORMAT ( Cantidad, "#,0" ) & "</span></div>",
        "",
        'silver_gtfs_agency'[source_feed_version], ASC
    )
VAR FilasAgency =
    IF (
        Snapshots = 1,
        CONCATENATEX (
            SUMMARIZE ( 'silver_gtfs_agency', 'silver_gtfs_agency'[agency_id], 'silver_gtfs_agency'[agency_name] ),
            VAR NombreSeguro = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( 'silver_gtfs_agency'[agency_name], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
            VAR IdSeguro = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( 'silver_gtfs_agency'[agency_id], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
            RETURN "<div style='display:flex;gap:10px;align-items:center;padding:7px 0'><span style='display:inline-block;min-width:24px;padding:3px;border-radius:5px;background:#FFFFFF;text-align:center;font-size:12px;color:#535B57'>"
                & IdSeguro & "</span><span style='font-size:13px'>" & NombreSeguro & "</span></div>",
            "",
            'silver_gtfs_agency'[agency_id], ASC
        ),
        IF ( Snapshots = 0, "<p>El filtro actual no contiene registros.</p>",
            "<p style='font-size:14px;line-height:1.6;color:#535B57'>Selecciona una versión en el filtro para consultar sus nombres e identificadores.</p>" )
    )
VAR Estado = SWITCH ( TRUE (), Snapshots = 0, "SIN DATOS", Snapshots = 1, "UN SNAPSHOT", "VISTA HISTÓRICA" )
RETURN
    "<div style='box-sizing:border-box;width:100%;padding:28px;background:#F4F4EF;border:1px solid #DADBD4;border-radius:20px;color:#202B26;font-family:Segoe UI,Arial,sans-serif'>"
    & "<div style='display:flex;justify-content:space-between;align-items:center;gap:12px'><span style='font-size:12px;letter-spacing:2px;font-weight:700;color:#535B57'>BOGOTÁ · GTFS</span><span style='padding:6px 10px;border-radius:20px;background:#202B26;color:#FFFFFF;font-size:10px;letter-spacing:1px'>" & Estado & "</span></div>"
    & "<h2 style='font-size:30px;font-weight:600;margin:20px 0 5px'>Agencias del feed</h2><p style='margin:0;color:#535B57;font-size:13px'>Información publicada en agency.txt · Prueba de presentación</p>"
    & "<div style='display:flex;gap:16px;margin:24px 0'><div style='flex:2;background:#FFFFFF;border-radius:14px;padding:20px;border-top:4px solid #DD212C'><div style='font-size:12px;color:#535B57'>REGISTROS DE AGENCIA</div><div style='font-size:58px;font-weight:600;line-height:1.15;margin-top:8px;color:#DD212C'>"
    & FORMAT ( Registros, "#,0" ) & "</div><div style='font-size:12px;color:#535B57;margin-top:8px'>Una fila por agencia y snapshot.</div></div>"
    & "<div style='flex:1;background:#E4EAF0;border-radius:14px;padding:20px;border-top:4px solid #004499'><div style='font-size:12px;color:#535B57'>SNAPSHOTS</div><div style='font-size:58px;font-weight:600;line-height:1.15;margin-top:8px;color:#004499'>"
    & FORMAT ( Snapshots, "#,0" ) & "</div><div style='font-size:12px;color:#535B57;margin-top:8px'>Versión + SHA-256.</div></div></div>"
    & "<div style='display:flex;gap:24px'><div style='flex:1;min-width:0'><h3 style='font-size:14px;margin:0 0 8px'>Registros por snapshot</h3>" & FilasVersion
    & "</div><div style='flex:1;min-width:0'><h3 style='font-size:14px;margin:0 0 8px'>Agencias en el filtro</h3>" & FilasAgency & "</div></div>"
    & "<div style='border-top:1px solid #DADBD4;margin-top:22px;padding-top:14px;font-size:12px;line-height:1.6;color:#535B57'>Un ID puede cambiar de significado entre versiones. Estos registros no representan empresas legales ni contratos.</div></div>"
