General · Cobertura HTML =
VAR Total = [Viajes evaluados]
VAR Varias = [Viajes con varias visitas]
VAR Una = [Viajes con una visita]
VAR Sin = [Viajes sin visitas]
VAR PVarias = DIVIDE ( Varias, Total, 0 ) * 100
VAR PUna = DIVIDE ( Una, Total, 0 ) * 100
VAR PSin = DIVIDE ( Sin, Total, 0 ) * 100
VAR Arcos = "<circle cx='66' cy='66' r='54' pathLength='100' fill='none' stroke='#FFC928' stroke-width='10' stroke-dasharray='" & FORMAT ( PVarias, "0.0000", "en-US" ) & " 100' transform='rotate(-90 66 66)'/><circle cx='66' cy='66' r='54' pathLength='100' fill='none' stroke='#848D90' stroke-width='10' stroke-dasharray='" & FORMAT ( PUna, "0.0000", "en-US" ) & " 100' stroke-dashoffset='-" & FORMAT ( PVarias, "0.0000", "en-US" ) & "' transform='rotate(-90 66 66)'/><circle cx='66' cy='66' r='54' pathLength='100' fill='none' stroke='#DD212C' stroke-width='10' stroke-dasharray='" & FORMAT ( PSin, "0.0000", "en-US" ) & " 100' stroke-dashoffset='-" & FORMAT ( PVarias + PUna, "0.0000", "en-US" ) & "' transform='rotate(-90 66 66)'/>"
VAR Contenido = IF ( ISBLANK ( Total ), "<div class='coverage-empty'><strong>—</strong><p>Sin evaluación Gold para este contexto.</p></div>", "<div class='coverage-body'><div class='ring'><svg viewBox='0 0 132 132' role='img' aria-label='Composición de cobertura de visitas'><circle cx='66' cy='66' r='54' fill='none' stroke='#EEEFEA' stroke-width='10'/>" & Arcos & "</svg><div><strong>" & FORMAT ( DIVIDE ( Varias, Total ), "0.00%", "es-CO" ) & "</strong><span>varias visitas</span></div></div><dl><div><dt><i class='swatch several'></i>Varias</dt><dd>" & FORMAT ( Varias, "#,0", "es-CO" ) & "</dd></div><div><dt><i class='swatch one'></i>Una</dt><dd>" & FORMAT ( Una, "#,0", "es-CO" ) & "</dd></div><div><dt><i class='swatch missing'></i>Sin visitas</dt><dd>" & FORMAT ( Sin, "#,0", "es-CO" ) & "</dd></div></dl></div>" )
RETURN "<section class='panel coverage-panel'><h2>Cobertura de visitas</h2>" & Contenido & IF ( NOT ISBLANK ( Total ), "<p class='base-count'>Base: " & FORMAT ( Total, "#,0", "es-CO" ) & " viajes evaluados</p>", "" ) & "<p class='note'>Varias visitas no certifican un recorrido completo.</p></section>"
