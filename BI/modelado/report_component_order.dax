report_component_order =
VAR Nombre = UPPER ( TRIM ( silver_gtfs_agency[agency_name] ) )
RETURN SWITCH ( TRUE (),
    Nombre = "TRANSMILENIO-TRONCAL", 1,
    Nombre IN { "TRANSMILENIO-ALIMENTADORES", "TRANSMILENIO-ALIMENTADORA" }, 3,
    Nombre IN { "ZONAL-URBANO", "ZONAL-COMPLEMENTARIO", "ZONAL-ESPECIAL", "TRANSMILENIO-URBANA", "TRANSMILENIO-COMPLEMENTARIA", "TRANSMILENIO-ESPECIAL" }, 2,
    Nombre = "TRANSMILENIO-DUAL", 4,
    Nombre IN { "TRANSMICABLE", "CABLE" }, 5,
    99
)
