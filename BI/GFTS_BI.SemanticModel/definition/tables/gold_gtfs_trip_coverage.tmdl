	partition gold_gtfs_trip_coverage = m
		mode: import
		source =
				let
				    Origen = DatabricksMultiCloud.Catalogs(DatabricksServerHostname, DatabricksHttpPath, null),
				    Catalogo = Origen{[Name = "workspace", Kind = "Database"]}[Data],
				    Esquema = Catalogo{[Name = "gtfs_bogota", Kind = "Schema"]}[Data],
				    Cobertura = Esquema{[Name = "gold_gtfs_trip_coverage", Kind = "Table"]}[Data],
				    Seleccion = Table.SelectColumns(Cobertura, {"source_feed_version", "source_sha256", "trip_id", "route_id", "service_id", "visit_count", "complete_time_pair_count", "visits_without_complete_time_pair", "frequency_window_count", "coverage_status", "scheduling_context"})
				in
				    Seleccion
