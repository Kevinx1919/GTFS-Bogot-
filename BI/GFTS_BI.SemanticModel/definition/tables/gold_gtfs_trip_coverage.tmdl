' y='123' width='193' height='20' rx='2' fill='#26383E'/><path d='M46 149h210v5H46z' fill='#FFC928'/><circle cx='77' cy='162' r='9' fill='#293033'/><circle cx='226' cy='162' r='9' fill='#293033'/><path d='M495 70v13' stroke='#4C595D' stroke-width='4'/><path d='M476 84h46l9 15-5 29h-53l-5-29z' fill='#DD212C'/><path d='M478 90h42l5 10-2 14h-47l-2-14z' fill='#26383E'/><path d='M475 118h48' stroke='#FFC928' stroke-width='4'/></svg>" )
			VAR Descripcion = SWITCH ( Componente, "Troncal", "Oferta declarada por la agencia Troncal. No mide buses en circulación.", "Zonal (SITP)", "Agrupa Urbana, Complementaria y Especial. Conserva el detalle por agencia.", "Alimentación", "Oferta declarada por las agencias de alimentación. Conserva la identidad de cada snapshot.", "Dual", "Mantiene Dual separado para evitar asignarlo automáticamente a Troncal o Zonal.", "TransMiCable", "Sus viajes pueden ser plantillas por frecuencia. No equivalen a salidas observadas.", "Explora la oferta planificada publicada en GTFS. Elige un componente para revisar su contexto." )
			RETURN "<section class='transport-panel'><div class='transport-title'><span>Componente seleccionado</span><h2>" & Componente & "</h2></div><div class='transport-art'>" & Arte & "</div><p>" & Descripcion & "</p><small>Ilustración propia / Sin escala ni cantidad de vehículos</small></section>"
		displayFolder: Presentación HTML/General
		lineageTag: a5d29406-c64d-4b1f-96b8-894073650ed6

