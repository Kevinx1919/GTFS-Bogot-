	/// Selección explícita de servicios activos; conserva identidad de snapshot, ruta y componente.
	measure 'Programación · Fuente HTML' = "<footer class='source-strip'><strong>Fuente: GTFS de TransMilenio · 2026</strong><span>Calendario y horas publicadas. No son operación observada, espera ni flota.</span></footer>"
		displayFolder: Programación\Presentación HTML
