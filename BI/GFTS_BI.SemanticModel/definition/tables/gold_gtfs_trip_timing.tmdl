		summarizeBy: none

	/// Código e ID de la ruta dentro de su versión/hash, para el detalle nativo de revisión.
	column report_route_label = LOOKUPVALUE(silver_gtfs_routes[report_route_label],silver_gtfs_routes[source_feed_version],[source_feed_version],silver_gtfs_routes[source_sha256],[source_sha256],silver_gtfs_routes[route_id],[route_id])
		dataType: string
		lineageTag: 43830956-6007-47b1-bddb-2ae0cac4993d
		summarizeBy: none

	partition gold_gtfs_trip_timing = m
		mode: import
		source =
				let
				    Origen = DatabricksMultiCloud.Catalogs(DatabricksServerHostname, DatabricksHttpPath, null),
				    Catalogo = Origen{[Name = "workspace", Kind = "Database"]}[Data],
				    Esquema = Catalogo{[Name = "gtfs_bogota", Kind = "Schema"]}[Data],
				    Cobertura = Esquema{[Name = "gold_gtfs_trip_timing", Kind = "Table"]}[Data],
				    Seleccion = Table.SelectColumns(Cobertura, {"source_feed_version", "source_sha256", "trip_id", "route_id", "service_id", "visit_count", "first_stop_id", "last_stop_id", "first_stop_sequence", "last_stop_sequence", "first_departure_time_seconds", "last_arrival_time_seconds", "frequency_window_count", "is_frequency_template", "endpoint_time_precision", "timing_status", "published_span_seconds"})
				in
				    Seleccion
