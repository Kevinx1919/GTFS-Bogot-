	/// Etiqueta de presentación de timing_status; conserva la clasificación Gold sin modificar Databricks.
	column report_review_reason = SWITCH([timing_status],"no_visits","Sin visitas","one_visit","Una visita","frequency_template","Plantilla por frecuencia","missing_endpoints","Sin extremos horarios","reversed_endpoints","Extremos invertidos","eligible","Elegible (referencia)","Estado no contemplado")
		dataType: string
