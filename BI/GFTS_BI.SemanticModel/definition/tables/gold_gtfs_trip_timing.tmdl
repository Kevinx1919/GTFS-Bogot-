	/// Catálogo 2026 del contexto de componente y ruta. Las fechas no convierten casos en viajes diarios.
	measure 'Revisión · Encabezado HTML' = VAR C=SELECTEDVALUE(silver_gtfs_agency[report_component],"Todo el sistema") VAR R=IF(HASONEVALUE(silver_gtfs_routes[route_key])," · " & SELECTEDVALUE(silver_gtfs_routes[report_route_label]),"") RETURN "<header class='page-heading'><div><p class='section-label'>Movilidad Bogotá / Del motivo al viaje que conviene revisar</p><h1>Revisión de información</h1></div><div class='scope'><strong>" & C & R & "</strong><span>Catálogo 2026 · No representa fallos operativos</span></div></header>"
		displayFolder: Revisión\Presentación HTML
