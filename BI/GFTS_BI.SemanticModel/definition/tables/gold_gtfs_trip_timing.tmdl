	/// Disponibilidad de ambas Gold importadas para una identidad única. No sustituye su auditoría de publicación.
	measure 'Revisión · Fuente disponible' = VAR P=SUMMARIZE(dim_gtfs_snapshot,dim_gtfs_snapshot[source_feed_version],dim_gtfs_snapshot[source_sha256]) VAR T=CALCULATE(COUNTROWS(gold_gtfs_trip_timing),REMOVEFILTERS(gold_gtfs_trip_timing),TREATAS(P,gold_gtfs_trip_timing[source_feed_version],gold_gtfs_trip_timing[source_sha256])) VAR C=CALCULATE(COUNTROWS(gold_gtfs_trip_coverage),REMOVEFILTERS(gold_gtfs_trip_coverage),TREATAS(P,gold_gtfs_trip_coverage[source_feed_version],gold_gtfs_trip_coverage[source_sha256])) RETURN HASONEVALUE(dim_gtfs_snapshot[snapshot_key])&&T>0&&C>0
		displayFolder: Revisión\Métricas
		lineageTag: 917b4e40-0bed-41b0-b693-32e1e395deed

	/// Catálogo 2026 del contexto de componente y ruta. Las fechas no convierten casos en viajes diarios.
	measure 'Revisión · Evaluados' =
			VAR Base=CALCULATETABLE(gold_gtfs_trip_timing,REMOVEFILTERS(gold_gtfs_trip_timing[report_review_reason],gold_gtfs_trip_timing[timing_status],gold_gtfs_trip_timing[trip_id],gold_gtfs_trip_timing[trip_key],gold_gtfs_trip_timing[report_route_label]))
			VAR Motivos=CALCULATETABLE(VALUES(gold_gtfs_trip_timing[timing_status]),REMOVEFILTERS(gold_gtfs_trip_timing[trip_id],gold_gtfs_trip_timing[trip_key],gold_gtfs_trip_timing[report_route_label]))
			VAR Casos=FILTER(Base,gold_gtfs_trip_timing[timing_status]<>"eligible" && gold_gtfs_trip_timing[timing_status] IN Motivos)
			RETURN IF([Revisión · Fuente disponible],COALESCE(COUNTROWS(Base),0))
