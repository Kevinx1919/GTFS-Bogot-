		summarizeBy: none
		sourceColumn: source_sha256

		annotation SummarizationSetBy = Automatic

	/// Clave de consumo v1: longitud y versión fuente, más SHA-256. No modifica la identidad Silver.
	column snapshot_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256]
		dataType: string
		isHidden
		lineageTag: c6ee44eb-df71-40bc-931e-34724a0e2ce1
		summarizeBy: none

	/// Clave de consumo v1 por snapshot e ID fuente sin conversiones ni eliminación de ceros.
	column route_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256] & ":" & [route_id]
		dataType: string
		isHidden
		lineageTag: 26529feb-01c6-4acd-8503-d471edbfa537
		summarizeBy: none

	/// Clave de consumo v1 por snapshot e ID fuente sin conversiones ni eliminación de ceros.
	column agency_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256] & ":" & [agency_id]
		dataType: string
		isHidden
		lineageTag: a7c4b2cc-0947-4685-aded-5244fe0c0a21
		summarizeBy: none

	/// Etiqueta de selección que distingue rutas con el mismo nombre corto. La identidad permanece en route_key por snapshot.
	column report_route_label = COALESCE([route_short_name],[route_id]) & " · " & [route_id]
		dataType: string
		lineageTag: fde4092f-f740-4434-9342-1df57a34478e
		summarizeBy: none

