	partition gold_gtfs_route_service_day = m
		mode: import
		source =
				let
				    Origen = DatabricksMultiCloud.Catalogs(DatabricksServerHostname, DatabricksHttpPath, null),
				    Catalogo = Origen{[Name = "workspace", Kind = "Database"]}[Data],
				    Esquema = Catalogo{[Name = "gtfs_bogota", Kind = "Schema"]}[Data],
				    Cobertura = Esquema{[Name = "gold_gtfs_route_service_day", Kind = "Table"]}[Data],
				    Seleccion = Table.SelectColumns(Cobertura, {"source_feed_version", "source_sha256", "route_id", "service_date", "declared_trip_count", "trips_without_frequency_count", "frequency_template_count", "frequency_window_count", "trips_without_visits_count", "trips_with_one_visit_count", "trips_with_multiple_visits_count", "active_service_count", "source_temporal_warning", "analysis_window_start", "analysis_window_end"})
				in
				    Seleccion
