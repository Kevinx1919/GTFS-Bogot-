		annotation SummarizationSetBy = Automatic

	column source_sha256
		dataType: string
		isHidden
		lineageTag: e7081689-016e-40b2-82ed-6191525698c4
		summarizeBy: none
		sourceColumn: source_sha256

		annotation SummarizationSetBy = Automatic

	/// Clave de consumo v1: longitud y versión fuente, más SHA-256. No modifica la identidad Silver.
	column snapshot_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256]
		dataType: string
		isHidden
		lineageTag: 4732df8f-69bd-4c8a-bf47-1109a8ae398f
		summarizeBy: none

	/// Clave de consumo v1 por snapshot e ID fuente sin conversiones ni eliminación de ceros.
	column stop_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256] & ":" & [stop_id]
		dataType: string
		isHidden
		lineageTag: 223e50fc-cc30-44af-bf28-865392297fbf
		summarizeBy: none

	/// Etiqueta de consulta por nombre e ID. No fusiona plataformas ni estaciones y no es clave de relación.
	column report_stop_label = COALESCE([stop_name],[stop_id]) & " · " & [stop_id]
		dataType: string
		lineageTag: 428a49a1-c496-4b10-a3e6-e4aa468e931c
		summarizeBy: none

