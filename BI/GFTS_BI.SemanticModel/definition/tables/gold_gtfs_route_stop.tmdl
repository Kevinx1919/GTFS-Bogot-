	column route_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256] & ":" & [route_id]
		dataType: string
		isHidden
		lineageTag: ae3828a9-09c9-47b3-9fa7-d990e075d703
		summarizeBy: none

	column stop_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256] & ":" & [stop_id]
		dataType: string
		isHidden
		lineageTag: c879f4fe-4bbf-4d0a-8312-1b282daa33f1
		summarizeBy: none

	/// Etiqueta de presentación por clave de ubicación, para selección nativa en el puente. No modifica Gold de Databricks.
	column report_stop_label = LOOKUPVALUE(silver_gtfs_stops[report_stop_label],silver_gtfs_stops[stop_key],[stop_key])
		dataType: string
		lineageTag: c5eb3c52-4232-49fa-af4e-bcabcd67a9cf
		summarizeBy: none

	/// Grado global del catálogo por stop_key. Una pareja única por ruta permite contar filas como rutas. Se recalcula al actualizar el modelo.
	column report_stop_route_count = CALCULATE(COUNTROWS(gold_gtfs_route_stop),ALLEXCEPT(gold_gtfs_route_stop,gold_gtfs_route_stop[stop_key]))
		dataType: int64
		lineageTag: 42adf677-f1aa-450c-a2e3-0dfb910992b9
		summarizeBy: none

	partition gold_gtfs_route_stop = m
		mode: import
		source =
				let
				    Origen = DatabricksMultiCloud.Catalogs(DatabricksServerHostname, DatabricksHttpPath, null),
				    Catalogo = Origen{[Name = "workspace", Kind = "Database"]}[Data],
				    Esquema = Catalogo{[Name = "gtfs_bogota", Kind = "Schema"]}[Data],
				    Cobertura = Esquema{[Name = "gold_gtfs_route_stop", Kind = "Table"]}[Data],
				    Seleccion = Table.SelectColumns(Cobertura, {"source_feed_version", "source_sha256", "route_id", "stop_id", "published_visit_count", "declared_trip_count"})
				in
				    Seleccion
