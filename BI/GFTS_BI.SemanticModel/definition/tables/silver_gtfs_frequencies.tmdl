	column source_feed_version
		dataType: string
		isHidden
		lineageTag: 7c476f1a-58ba-4d56-a3a5-20cb63c3da69
		summarizeBy: none
		sourceColumn: source_feed_version

		annotation SummarizationSetBy = Automatic

	column source_sha256
		dataType: string
		isHidden
		lineageTag: ea83a26c-4e6e-4695-b96d-ad5b6c772d31
		summarizeBy: none
		sourceColumn: source_sha256

		annotation SummarizationSetBy = Automatic

	/// Clave de consumo v1: longitud y versión fuente, más SHA-256. No modifica la identidad Silver.
	column snapshot_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256]
		dataType: string
		isHidden
		lineageTag: 957271a1-c8c6-49bc-98ce-f95a8945744c
		summarizeBy: none

	/// Clave de consumo v1 por snapshot e ID fuente sin conversiones ni eliminación de ceros.
	column trip_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256] & ":" & [trip_id]
		dataType: string
		isHidden
		lineageTag: 072af917-ecc3-4710-a585-edc80f245cd5
		summarizeBy: none

	partition silver_gtfs_frequencies = m
		mode: import
		source =
