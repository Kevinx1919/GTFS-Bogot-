table silver_gtfs_frequencies
	lineageTag: 781f9207-170f-4172-a996-4c05cc3440b7

	/// Ventanas publicadas del contexto. No cuenta vehículos ni salidas individuales.
	measure 'Ventanas de frecuencia' = COALESCE ( COUNTROWS ( 'silver_gtfs_frequencies' ), 0 )
		formatString: #,0
		displayFolder: Frecuencias
		lineageTag: 666c72f3-5b65-487c-ba2e-a582eaa66b92

	/// Viajes/plantillas distintas con ventanas publicadas; conserva el snapshot y evita contar una plantilla por cada ventana.
	measure 'Plantillas con frecuencia' = COALESCE ( DISTINCTCOUNT ( 'silver_gtfs_frequencies'[trip_key] ), 0 )
		formatString: #,0
		displayFolder: Frecuencias
		lineageTag: aabb386d-98d3-4245-a885-2f1b89b3431e

	column trip_id
		dataType: string
		lineageTag: 73938bd5-ea98-4dd7-8a69-c4914f9b00eb
