table silver_gtfs_agency
	lineageTag: 170a90d6-90cf-42b4-8a23-4f3f77d4db55

	/// Cuenta registros agencia-snapshot del contexto actual. No cuenta empresas ni contratos.
	measure 'Registros de agencia' = COUNTROWS('silver_gtfs_agency')
		formatString: #,0
		displayFolder: Comprobación
		lineageTag: 4cd5b7de-b600-4bf3-be7a-25d26de63745

	/// Cuenta las identidades versión y SHA-256 presentes en el contexto actual.
	measure 'Snapshots cargados' = COUNTROWS(SUMMARIZE('silver_gtfs_agency', 'silver_gtfs_agency'[source_feed_version], 'silver_gtfs_agency'[source_sha256]))
		formatString: #,0
		displayFolder: Comprobación
		lineageTag: ea8c28e8-19bd-425b-9291-2afbcd0e988c

	/// Tarjeta HTML de prueba. Presenta registros y snapshots del contexto actual. No cuenta empresas legales. Separa identidades versión/SHA-256.
	measure 'Tarjeta agency HTML' =
			VAR Registros = COALESCE ( [Registros de agencia], 0 )
			VAR Snapshots = COALESCE ( [Snapshots cargados], 0 )
			VAR Versiones =
			    SUMMARIZE (
			        'silver_gtfs_agency',
			        'silver_gtfs_agency'[source_feed_version],
			        'silver_gtfs_agency'[source_sha256]
			    )
			VAR FilasVersion =
			    CONCATENATEX (
			        Versiones,
			        VAR FeedVersionValue = 'silver_gtfs_agency'[source_feed_version]
			        VAR SnapshotHashValue = 'silver_gtfs_agency'[source_sha256]
			        VAR Cantidad = COALESCE ( CALCULATE ( [Registros de agencia] ), 0 )
			        RETURN
			            "<div style='display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #DADBD4'>"
			            & "<div><strong>" & FeedVersionValue & "</strong><div style='font-size:11px;color:#535B57;margin-top:3px'>SHA-256 · "
			            & LEFT ( SnapshotHashValue, 12 ) & "…</div></div><span style='font-size:22px;font-weight:700'>"
			            & FORMAT ( Cantidad, "#,0" ) & "</span></div>",
			        "",
			        'silver_gtfs_agency'[source_feed_version], ASC
			    )
			VAR FilasAgency =
			    IF (
			        Snapshots = 1,
			        CONCATENATEX (
			            SUMMARIZE ( 'silver_gtfs_agency', 'silver_gtfs_agency'[agency_id], 'silver_gtfs_agency'[agency_name] ),
			            VAR NombreSeguro = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( 'silver_gtfs_agency'[agency_name], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
			            VAR IdSeguro = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( 'silver_gtfs_agency'[agency_id], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
			            RETURN "<div style='display:flex;gap:10px;align-items:center;padding:7px 0'><span style='display:inline-block;min-width:24px;padding:3px;border-radius:5px;background:#FFFFFF;text-align:center;font-size:12px;color:#535B57'>"
			                & IdSeguro & "</span><span style='font-size:13px'>" & NombreSeguro & "</span></div>",
			            "",
			            'silver_gtfs_agency'[agency_id], ASC
			        ),
			        IF ( Snapshots = 0, "<p>El filtro actual no contiene registros.</p>",
			            "<p style='font-size:14px;line-height:1.6;color:#535B57'>Selecciona una versión en el filtro para consultar sus nombres e identificadores.</p>" )
			    )
			VAR Estado = SWITCH ( TRUE (), Snapshots = 0, "SIN DATOS", Snapshots = 1, "UN SNAPSHOT", "VISTA HISTÓRICA" )
			RETURN
			    "<div style='box-sizing:border-box;width:100%;padding:28px;background:#F4F4EF;border:1px solid #DADBD4;border-radius:20px;color:#202B26;font-family:Segoe UI,Arial,sans-serif'>"
			    & "<div style='display:flex;justify-content:space-between;align-items:center;gap:12px'><span style='font-size:12px;letter-spacing:2px;font-weight:700;color:#535B57'>BOGOTÁ · GTFS</span><span style='padding:6px 10px;border-radius:20px;background:#202B26;color:#FFFFFF;font-size:10px;letter-spacing:1px'>" & Estado & "</span></div>"
			    & "<h2 style='font-size:30px;font-weight:600;margin:20px 0 5px'>Agencias del feed</h2><p style='margin:0;color:#535B57;font-size:13px'>Información publicada en agency.txt · Prueba de presentación</p>"
			    & "<div style='display:flex;gap:16px;margin:24px 0'><div style='flex:2;background:#FFFFFF;border-radius:14px;padding:20px;border-top:4px solid #DD212C'><div style='font-size:12px;color:#535B57'>REGISTROS DE AGENCIA</div><div style='font-size:58px;font-weight:600;line-height:1.15;margin-top:8px;color:#DD212C'>"
			    & FORMAT ( Registros, "#,0" ) & "</div><div style='font-size:12px;color:#535B57;margin-top:8px'>Una fila por agencia y snapshot.</div></div>"
			    & "<div style='flex:1;background:#E4EAF0;border-radius:14px;padding:20px;border-top:4px solid #004499'><div style='font-size:12px;color:#535B57'>SNAPSHOTS</div><div style='font-size:58px;font-weight:600;line-height:1.15;margin-top:8px;color:#004499'>"
			    & FORMAT ( Snapshots, "#,0" ) & "</div><div style='font-size:12px;color:#535B57;margin-top:8px'>Versión + SHA-256.</div></div></div>"
			    & "<div style='display:flex;gap:24px'><div style='flex:1;min-width:0'><h3 style='font-size:14px;margin:0 0 8px'>Registros por snapshot</h3>" & FilasVersion
			    & "</div><div style='flex:1;min-width:0'><h3 style='font-size:14px;margin:0 0 8px'>Agencias en el filtro</h3>" & FilasAgency & "</div></div>"
			    & "<div style='border-top:1px solid #DADBD4;margin-top:22px;padding-top:14px;font-size:12px;line-height:1.6;color:#535B57'>Un ID puede cambiar de significado entre versiones. Estos registros no representan empresas legales ni contratos.</div></div>"
		displayFolder: Agency\HTML
		lineageTag: 8ea11712-e824-4537-a730-c97504d8ebca

	column agency_id
		dataType: string
		lineageTag: 89f392ac-7fd7-46d3-939c-6aa6e95b5930
		summarizeBy: none
		sourceColumn: agency_id

		annotation SummarizationSetBy = Automatic

	column agency_name
		dataType: string
		lineageTag: d1f89f48-a6f4-491c-885f-996de9cd9fbb
		summarizeBy: none
		sourceColumn: agency_name

		annotation SummarizationSetBy = Automatic

	column source_feed_version
		dataType: string
		isHidden
		lineageTag: 944297f6-dd7b-4513-ad8f-bc14b834281d
		summarizeBy: none
		sourceColumn: source_feed_version

		annotation SummarizationSetBy = Automatic

	column source_sha256
		dataType: string
		isHidden
		lineageTag: c5902c2e-1c63-4b2a-bc5c-ae357603e86a
		summarizeBy: none
		sourceColumn: source_sha256

		annotation SummarizationSetBy = Automatic

	/// Clave de consumo v1: longitud y versión fuente, más SHA-256. No modifica la identidad Silver.
	column snapshot_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256]
		dataType: string
		isHidden
		lineageTag: 7310830d-c978-420e-b2ea-5ad8a8c23ed3
		summarizeBy: none

	/// Clave de consumo v1 por snapshot e ID fuente sin conversiones ni eliminación de ceros.
	column agency_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256] & ":" & [agency_id]
		dataType: string
		isHidden
		lineageTag: f30af025-d860-48d2-b1da-862662eb33fa
		summarizeBy: none

	/// Agrupación analítica por nombres publicados: Troncal, Zonal (SITP), Alimentación, Dual y TransMiCable. No clasifica operadores ni contratos; otros nombres quedan Sin clasificar. Conserva las claves de snapshot existentes.
	column report_component =
			VAR Nombre = UPPER ( TRIM ( silver_gtfs_agency[agency_name] ) )
			RETURN SWITCH ( TRUE (),
			    Nombre = "TRANSMILENIO-TRONCAL", "Troncal",
			    Nombre IN { "TRANSMILENIO-ALIMENTADORES", "TRANSMILENIO-ALIMENTADORA" }, "Alimentación",
			    Nombre IN { "ZONAL-URBANO", "ZONAL-COMPLEMENTARIO", "ZONAL-ESPECIAL", "TRANSMILENIO-URBANA", "TRANSMILENIO-COMPLEMENTARIA", "TRANSMILENIO-ESPECIAL" }, "Zonal (SITP)",
			    Nombre = "TRANSMILENIO-DUAL", "Dual",
			    Nombre IN { "TRANSMICABLE", "CABLE" }, "TransMiCable",
			    "Sin clasificar"
			)
		dataType: string
		displayFolder: Presentación
		lineageTag: 5f9d8450-1574-4a4c-8e3f-80fcad4da638
		sortByColumn: report_component_order

	/// Orden de presentación de componentes. No es una clave de relación.
	column report_component_order =
			VAR Nombre = UPPER ( TRIM ( silver_gtfs_agency[agency_name] ) )
			RETURN SWITCH ( TRUE (),
			    Nombre = "TRANSMILENIO-TRONCAL", 1,
			    Nombre IN { "TRANSMILENIO-ALIMENTADORES", "TRANSMILENIO-ALIMENTADORA" }, 3,
			    Nombre IN { "ZONAL-URBANO", "ZONAL-COMPLEMENTARIO", "ZONAL-ESPECIAL", "TRANSMILENIO-URBANA", "TRANSMILENIO-COMPLEMENTARIA", "TRANSMILENIO-ESPECIAL" }, 2,
			    Nombre = "TRANSMILENIO-DUAL", 4,
			    Nombre IN { "TRANSMICABLE", "CABLE" }, 5,
			    99
			)
		dataType: int64
		isHidden
		lineageTag: 9299b19b-ad86-4366-9db5-e9ccc7074fd0

	partition silver_gtfs_agency = m
		mode: import
		source =
				let
				  Origen = DatabricksMultiCloud.Catalogs(DatabricksServerHostname, DatabricksHttpPath, [Catalog = null, Database = null, QueryTags = null, EnableAutomaticProxyDiscovery = "enabled", Implementation = "2.0", Protocol = null]),
				  #"Navegación 1" = Origen{[Name = "workspace", Kind = "Database"]}[Data],
				  #"Navegación 2" = #"Navegación 1"{[Name = "gtfs_bogota", Kind = "Schema"]}[Data],
				  #"Navegación 3" = #"Navegación 2"{[Name = "silver_gtfs_agency", Kind = "Table"]}[Data],
				  #"Columnas quitadas" = Table.RemoveColumns(#"Navegación 3", {"agency_url", "agency_timezone", "agency_lang", "agency_phone", "agency_fare_url", "agency_email", "source_file_path", "bronze_loaded_at_utc", "source_columns", "silver_rule_version", "silver_run_id", "silver_loaded_at_utc"})
				in
				  #"Columnas quitadas"

	annotation PBI_ResultType = Table
