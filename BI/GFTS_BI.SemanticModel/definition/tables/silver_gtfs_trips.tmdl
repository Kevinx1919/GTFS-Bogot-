	column source_feed_version
		dataType: string
		isHidden
		lineageTag: cb27d5e1-6650-4604-bf0a-c96fba7da6c3
		summarizeBy: none
		sourceColumn: source_feed_version

		annotation SummarizationSetBy = Automatic

	column source_sha256
		dataType: string
		isHidden
		lineageTag: 2ef536c1-b507-4344-93e6-e8b89840ab49
		summarizeBy: none
		sourceColumn: source_sha256

		annotation SummarizationSetBy = Automatic

	/// Clave de consumo v1: longitud y versión fuente, más SHA-256. No modifica la identidad Silver.
	column snapshot_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256]
		dataType: string
		isHidden
		lineageTag: ea1abe44-4a55-43fc-befd-a33578e65008
		summarizeBy: none

	/// Clave de consumo v1 por snapshot e ID fuente sin conversiones ni eliminación de ceros.
	column trip_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256] & ":" & [trip_id]
		dataType: string
		isHidden
		lineageTag: ddd5843b-7a2b-4b98-9b5f-d93d81aa03d0
		summarizeBy: none

	/// Clave de consumo v1 por snapshot e ID fuente sin conversiones ni eliminación de ceros.
	column route_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256] & ":" & [route_id]
		dataType: string
		isHidden
		lineageTag: 14917a76-2494-4f96-9789-b6be6bbfb0e2
		summarizeBy: none

	/// Clave de consumo v1 por snapshot e ID fuente sin conversiones ni eliminación de ceros.
	column service_key = FORMAT ( LEN ( [source_feed_version] ), "0" ) & ":" & [source_feed_version] & ":" & [source_sha256] & ":" & [service_id]
		dataType: string
		isHidden
		lineageTag: f1aa1a43-8d37-4d4f-b90c-29b209593702
		summarizeBy: none

