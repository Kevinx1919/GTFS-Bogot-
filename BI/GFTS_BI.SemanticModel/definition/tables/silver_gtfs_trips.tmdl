table silver_gtfs_trips
	lineageTag: dfdc6985-7fe6-4dfd-a7b5-ace94e32d2d8

	/// Registros trips dentro del contexto snapshot/agencia/ruta. Incluye plantillas por frecuencia. No representa salidas operadas ni programación por fecha.
	measure 'Viajes declarados' = COALESCE ( COUNTROWS ( 'silver_gtfs_trips' ), 0 )
		formatString: #,0
		displayFolder: Catálogo
		lineageTag: 5256a518-b951-49e9-8f9b-2106ae0360be

	column trip_id
		dataType: string
		lineageTag: a475a249-daa7-475a-94b2-da7c0b6aa111
		summarizeBy: none
		sourceColumn: trip_id

		annotation SummarizationSetBy = Automatic

	column route_id
