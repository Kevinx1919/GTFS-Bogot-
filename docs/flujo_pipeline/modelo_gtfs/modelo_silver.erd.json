      {
        "id": "viajes",
        "label": "Viajes y visitas",
        "focus": [
          "agency",
          "routes",
          "trips",
          "frequencies",
          "stop_times",
          "stops"
        ],
        "note": "Stop_times relaciona visitas con viajes y paradas dentro del mismo snapshot."
      },
      {
        "id": "servicios",
        "label": "Calendarios y días activos",
        "focus": [
          "calendar",
          "calendar_dates",
          "service_dates",
          "service_ids",
          "trips"
        ],
        "note": "Service_ids es un catálogo lógico de IDs. No es otra tabla Silver persistida."
      },
      {
        "id": "geometria",
        "label": "Trazados y ubicaciones",
        "focus": [
          "stops",
          "shape_points",
          "shape_ids",
          "trips"
        ],
        "note": "Shape_ids agrupa IDs. Shape_points conserva varios puntos por trazado."
      },
      {
        "id": "frecuencia",
        "label": "Detalle de frequencies",
        "focus": [
          "frequencies",
          "trips"
        ],
        "note": "Conservo exact_times ausente y su interpretación efectiva por separado."
      },
      {
        "id": "visitas",
        "label": "Visitas, paradas y frecuencias",
        "focus": [
          "stop_times",
          "stops",
          "trips",
          "frequencies"
        ],
        "note": "Una visita no es un vehículo. Frequencies se agrupa por viaje antes de aportar contexto."
      }
    ]
  },
