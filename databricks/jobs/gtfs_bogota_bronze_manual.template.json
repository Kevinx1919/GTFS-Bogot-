      "notebook_task": {
        "notebook_path": "/Workspace/REPO_ROOT/databricks/notebooks/05_bronze_static_gtfs_operational_entities",
        "base_parameters": {
          "feed_version": "{{tasks.raw_gtfs.values.feed_version}}",
          "snapshot_sha256": "{{tasks.raw_gtfs.values.snapshot_sha256}}"
        },
