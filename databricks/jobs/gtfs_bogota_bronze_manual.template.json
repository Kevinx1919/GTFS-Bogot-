      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "validar_bronze",
      "depends_on": [
        {
          "task_key": "bronze_operativos"
        },
        {
          "task_key": "bronze_referencias"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/REPO_ROOT/databricks/notebooks/07_validate_bronze_gtfs_snapshot",
        "base_parameters": {
