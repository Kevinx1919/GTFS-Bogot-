        {
          "task_key": "raw_gtfs"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/REPO_ROOT/databricks/notebooks/03_bronze_static_gtfs",
        "base_parameters": {
          "feed_version": "{{tasks.raw_gtfs.values.feed_version}}",
          "snapshot_sha256": "{{tasks.raw_gtfs.values.snapshot_sha256}}"
