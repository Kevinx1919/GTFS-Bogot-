        {
          "task_key": "staging_y_rutas"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/REPO_ROOT/databricks/notebooks/04_bronze_static_gtfs_reference_entities",
