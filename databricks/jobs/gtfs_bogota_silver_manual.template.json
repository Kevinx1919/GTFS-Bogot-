      "task_key": "publish_snapshots",
      "for_each_task": {
        "inputs": "{{job.parameters.work_items}}",
        "concurrency": 1,
        "task": {
          "task_key": "process_entity_snapshot",
          "notebook_task": {
            "notebook_path": "/Workspace/REPO_ROOT/databricks/notebooks/silver/10_publish_gtfs_entity.ipynb",
            "source": "WORKSPACE",
            "base_parameters": {
              "repo_root": "/Workspace/REPO_ROOT",
              "catalog": "{{job.parameters.catalog}}",
              "schema": "{{job.parameters.schema}}",
              "staging_volume": "{{job.parameters.staging_volume}}",
              "mode": "{{job.parameters.mode}}",
              "verify_history": "{{job.parameters.verify_history}}",
              "entity": "{{input.entity}}",
              "feed_version": "{{input.feed_version}}",
              "snapshot_sha256": "{{input.snapshot_sha256}}"
            }
          },
          "environment_key": "silver",
          "timeout_seconds": 1800,
          "max_retries": 1,
          "min_retry_interval_millis": 60000
        }
      }
    },
    {
      "task_key": "publish_routes",
      "for_each_task": {
