      "task_key": "plan_silver",
      "environment_key": "silver",
      "timeout_seconds": 1800,
      "notebook_task": {
        "notebook_path": "/Workspace/REPO_ROOT/databricks/notebooks/silver/11_plan_silver.ipynb",
        "source": "WORKSPACE",
        "base_parameters": {
          "repo_root": "/Workspace/REPO_ROOT",
          "emit_task_values": "true",
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "feed_version_from": "{{job.parameters.feed_version_from}}",
          "feed_version_to": "{{job.parameters.feed_version_to}}",
          "max_snapshots": "{{job.parameters.max_snapshots}}",
          "max_metadata_rows": "{{job.parameters.max_metadata_rows}}"
        }
      }
    },
    {
      "task_key": "publish_snapshots",
      "for_each_task": {
        "inputs": "{{tasks.plan_silver.values.work_items}}",
        "concurrency": 1,
        "task": {
          "task_key": "process_entity_snapshot",
          "notebook_task": {
            "notebook_path": "/Workspace/REPO_ROOT/databricks/notebooks/silver/10_publish_gtfs_entity.ipynb",
