            "base_parameters": {
              "repo_root": "/Workspace/REPO_ROOT",
              "catalog": "{{job.parameters.catalog}}",
              "schema": "{{job.parameters.schema}}",
              "staging_volume": "{{job.parameters.staging_volume}}",
              "mode": "{{job.parameters.mode}}",
              "verify_history": "{{job.parameters.verify_history}}",
              "entity": "{{input.entity}}",
              "feed_version": "{{input.feed_version}}",
              "snapshot_sha256": "{{input.snapshot_sha256}}",
              "expected_rule_version": "{{input.expected_rule_version}}",
              "bronze_quality_run_id": "{{input.bronze_quality_run_id}}",
              "bronze_result_sha256": "{{input.bronze_result_sha256}}",
              "bronze_delta_version": "{{input.bronze_delta_version}}"
            }
          },
          "environment_key": "silver",
          "timeout_seconds": 1800,
          "max_retries": 1,
          "min_retry_interval_millis": 60000
        }
      },
      "depends_on": [
        {
          "task_key": "plan_silver"
        }
      ]
    },
