{
  "name": "gtfs_bogota_silver_manual",
  "description": "Planifica pendientes desde Bronze validado y publica Silver. Lanzamiento manual, sin schedule.",
  "max_concurrent_runs": 1,
  "queue": {
    "enabled": true
  },
  "parameters": [
    {
      "name": "catalog",
      "default": "workspace"
    },
    {
      "name": "schema",
      "default": "gtfs_bogota"
    },
    {
      "name": "staging_volume",
      "default": "staging_gtfs"
    },
    {
      "name": "mode",
      "default": "publish"
    },
    {
      "name": "verify_history",
      "default": "true"
    },
    {
      "name": "feed_version_from",
      "default": ""
    },
    {
      "name": "feed_version_to",
      "default": ""
    },
    {
      "name": "max_snapshots",
      "default": "20"
    },
    {
      "name": "max_metadata_rows",
      "default": "5000"
    }
  ],
  "environments": [
    {
      "environment_key": "silver",
      "spec": {
        "environment_version": "4",
        "dependencies": [
          "langcodes==3.5.1",
          "tzdata==2026.6"
        ]
      }
    }
  ],
  "tasks": [
